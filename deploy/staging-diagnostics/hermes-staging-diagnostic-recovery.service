[Unit]
Description=Restore interrupted Hermes staging diagnostic transaction
After=local-fs.target systemd-tmpfiles-setup.service docker.service
RequiresMountsFor=/opt/hermes-compose/staging /home/hermes-staging/.hermes-staging /var/lib/hermes-staging-diagnostics

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/hermes-staging-diagnostic --recover
TimeoutStartSec=270
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/hermes-compose/staging /home/hermes-staging/.hermes-staging /var/lib/hermes-staging-diagnostics /run/lock/hermes-staging-diagnostic.lock
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
