# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# fast-uri 3.1.5 includes fixes for vulns (GHSA-7p8r-x3mc-p8w7). remove this when 3.1.5 is > 2wks old (rel 2026-07-31)
min-release-age-exclude[]=fast-uri

# js-yaml 4.3.1 includes fixes for GHSA-5p4m-2wfm-xmqj. remove when > 2wks old (rel 2026-07-31)
min-release-age-exclude[]=js-yaml

# nanoid 3.3.17 includes fixes for GHSA-2v37-7h3g-55p8. remove when > 2wks old (rel 2026-08-03)
min-release-age-exclude[]=nanoid

# mermaid 11.16.1 includes fixes for 5 GHSAs. remove when > 2wks old (rel 2026-08-04)
min-release-age-exclude[]=mermaid

# dompurify 3.4.17 fixes GHSA-55q2-fjhq-7xh7 follow-ups (low). remove when 3.4.17 is > 2wks old (rel 2026-10-12)
min-release-age-exclude[]=dompurify

# minimatch 10.2.6 includes fixes for vulns. remove this when 10.2.6 is > 2wks  old
min-release-age-exclude[]=minimatch

# brace-expansion 5.0.8 includes fixes for vulns. remove this when 5.0.8 is > 2wks  old
min-release-age-exclude[]=brace-expansion

# undici 6.28.0 includes fixes for vulns. remove this when 6.28.0 is > 2wks old
min-release-age-exclude[]=undici

# @nous-research/image-size 2.0.3 includes fixes for vulns. remove this when 2.0.3 is > 2wks old
min-release-age-exclude[]=@nous-research/image-size


# Reviewed security exceptions, pinned by exact package.json overrides.
# source-map-js 1.2.2 (2026-09-30) fixes GHSA-68fv-2mgg-jv7q; remove after 14 days.
min-release-age-exclude[]=source-map-js
# http-cache-semantics 4.3.0 (2026-10-04) fixes GHSA-ch52-4w7c-c8xp; remove after 14 days.
min-release-age-exclude[]=http-cache-semantics

# October 24 security fixes, bounded by exact manifest pins and lock integrity.
# Remove these exclusions after the fixed releases exceed fourteen days.
min-release-age-exclude[]=body-parser
min-release-age-exclude[]=serialize-javascript

# qs 6.16.2 fixes GHSA-6pq8-jhm2-2vcw and follow-up hardening (2026-10-27).
# Exact manifest/lock pin; remove after 2026-11-10T19:27:00Z (14 days).
min-release-age-exclude[]=qs

# User-approved 2026-11-01 security exceptions; exact manifest overrides retain scope.
# glob 14.0.2: remove exception after 2026-11-10T22:07:01Z (14 days).
min-release-age-exclude[]=glob
# joi 17.13.9/18.3.1: remove exception after 2026-11-11T10:04:27Z (14 days).
min-release-age-exclude[]=joi
# follow-redirects 1.16.2: remove exception after 2026-11-08T21:32:26Z (14 days).
min-release-age-exclude[]=follow-redirects
# path-scurry 3.0.0: remove exception after 2026-11-10T21:14:49Z (14 days).
min-release-age-exclude[]=path-scurry
# @isaacs/nonrecursive-glob-match 1.0.1: remove exception after 2026-11-10T04:24:53Z (14 days).
min-release-age-exclude[]=@isaacs/nonrecursive-glob-match
